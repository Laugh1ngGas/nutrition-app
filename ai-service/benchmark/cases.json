{
  "chat": [
    {"id": "breakfast",   "uk": "Порадь швидкий білковий сніданок.",                          "en": "Suggest a quick high-protein breakfast."},
    {"id": "dinner",      "uk": "Що приготувати на вечерю з курки, рису та броколі?",          "en": "What can I cook for dinner with chicken, rice and broccoli?"},
    {"id": "meals_a_day", "uk": "Я хочу схуднути. Скільки разів на день краще їсти?",          "en": "I want to lose weight. How many times a day should I eat?"},
    {"id": "sugar",       "uk": "Чим замінити цукор у випічці?",                              "en": "What can I use instead of sugar in baking?"},
    {"id": "vegetarian",  "uk": "Склади меню на один день для вегетаріанця.",                  "en": "Make a one-day menu for a vegetarian."},
    {"id": "nut_allergy", "uk": "У мене алергія на горіхи. Які перекуси мені підійдуть?",      "en": "I'm allergic to nuts. What snacks are good for me?"},
    {"id": "protein_fact","uk": "Скільки білка в 100 г курячої грудки?",                       "en": "How much protein is in 100 g of chicken breast?"},
    {"id": "buckwheat",   "uk": "Що можна приготувати з гречки, крім каші?",                   "en": "What can I make from buckwheat besides porridge?"}
  ],

  "tools": {
    "definitions": [
      {"type": "function", "function": {
        "name": "swap_meal",
        "description": "Replace one meal in the user's current meal plan.",
        "parameters": {"type": "object", "properties": {
          "day": {"type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]},
          "meal_type": {"type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"]},
          "preference": {"type": "string", "description": "What the new meal should be like, in the user's words"}
        }, "required": ["day", "meal_type"]}
      }},
      {"type": "function", "function": {
        "name": "find_recipes",
        "description": "Search recipes that use the given ingredients.",
        "parameters": {"type": "object", "properties": {
          "ingredients": {"type": "array", "items": {"type": "string"}},
          "max_time_min": {"type": "integer", "description": "Maximum total cooking time in minutes"}
        }, "required": ["ingredients"]}
      }},
      {"type": "function", "function": {
        "name": "add_to_shopping_list",
        "description": "Add items to the user's shopping list.",
        "parameters": {"type": "object", "properties": {
          "items": {"type": "array", "items": {"type": "string"}}
        }, "required": ["items"]}
      }}
    ],
    "cases": [
      {"id": "swap_uk",     "text": "Заміни мені вечерю в середу на щось без м'яса.",
       "expect": {"name": "swap_meal", "args": {"day": "wednesday", "meal_type": "dinner"}}},
      {"id": "swap_en",     "text": "Swap my Friday breakfast for something with more protein.",
       "expect": {"name": "swap_meal", "args": {"day": "friday", "meal_type": "breakfast"}}},
      {"id": "find_uk",     "text": "Що я можу приготувати з яєць, помідорів і сиру за 15 хвилин?",
       "expect": {"name": "find_recipes", "ingredients_count": 3, "args": {"max_time_min": 15}}},
      {"id": "find_en",     "text": "Find me a recipe using potatoes and mushrooms.",
       "expect": {"name": "find_recipes", "ingredients_count": 2}},
      {"id": "shop_uk",     "text": "Додай молоко, хліб і банани до списку покупок.",
       "expect": {"name": "add_to_shopping_list", "items_count": 3}},
      {"id": "shop_en",     "text": "Put olive oil and garlic on my shopping list.",
       "expect": {"name": "add_to_shopping_list", "items_count": 2}},
      {"id": "no_tool_uk",  "text": "Привіт! Чим ти можеш мені допомогти?",
       "expect": {"name": null}},
      {"id": "no_tool_en",  "text": "Is it bad to eat late at night?",
       "expect": {"name": null}}
    ]
  },

